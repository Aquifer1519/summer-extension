{
  "manifest_version": 3,
  "name": "Text Analysis Tester",
  "version": "0.1.0",
  "description": "Predicts AI-likelihood and sentiment for selected or pasted text.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting", "contextMenus"],
  "host_permissions": ["http://127.0.0.1:5000/*"],
  "background": {
    "service_worker": "background.js"
  }
}
